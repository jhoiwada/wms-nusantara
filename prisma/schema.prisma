generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum DeliveryOrderStatus {
  DRAFT
  SHIPPED
  CANCELLED
}

enum StockOpnameStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MovementType {
  IN
  OUT
  ADJUST_IN
  ADJUST_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdGoodsReceipts  GoodsReceipt[]  @relation("CreatedGoodsReceipts")
  createdDeliveryOrders DeliveryOrder[] @relation("CreatedDeliveryOrders")
  createdStockOpnames   StockOpname[]   @relation("CreatedStockOpnames")
  approvedStockOpnames  StockOpname[]   @relation("ApprovedStockOpnames")
  stockMovements        StockMovement[]
  auditLogs             AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  sku         String   @unique
  barcode     String?  @unique
  name        String
  description String?
  uom         String   @default("PCS")
  minStock    Int      @default(0) @map("min_stock")
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(14, 2)
  trackExpiry Boolean  @default(false) @map("track_expiry")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category           Category           @relation(fields: [categoryId], references: [id])
  stocks             Stock[]
  movements          StockMovement[]
  batches            Batch[]
  goodsReceiptItems  GoodsReceiptItem[]
  deliveryOrderItems DeliveryOrderItem[]
  stockOpnameItems   StockOpnameItem[]

  @@map("products")
}

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  goodsReceipts GoodsReceipt[]

  @@map("suppliers")
}

model Customer {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deliveryOrders DeliveryOrder[]

  @@map("customers")
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations      Location[]
  goodsReceipts  GoodsReceipt[]
  deliveryOrders DeliveryOrder[]
  stockOpnames   StockOpname[]

  @@map("warehouses")
}

model Location {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  code        String
  zone        String
  rack        String
  level       String
  isFrozen    Boolean  @default(false) @map("is_frozen")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id])
  stocks             Stock[]
  movements          StockMovement[]
  goodsReceiptItems  GoodsReceiptItem[]
  deliveryOrderItems DeliveryOrderItem[]
  stockOpnameItems   StockOpnameItem[]

  @@unique([warehouseId, code])
  @@map("locations")
}

model Batch {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  batchNo    String    @map("batch_no")
  expiryDate DateTime? @map("expiry_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id])
  stocks             Stock[]
  movements          StockMovement[]
  deliveryOrderItems DeliveryOrderItem[]
  stockOpnameItems   StockOpnameItem[]

  @@unique([productId, batchNo])
  @@index([expiryDate])
  @@map("batches")
}

model Stock {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  batchId    String   @map("batch_id")
  quantity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@unique([productId, locationId, batchId])
  @@index([productId])
  @@index([locationId])
  @@index([batchId])
  @@map("stock")
}

model StockMovement {
  id           String       @id @default(uuid())
  productId    String       @map("product_id")
  locationId   String       @map("location_id")
  batchId      String       @map("batch_id")
  movementType MovementType @map("movement_type")
  quantity     Int
  balanceAfter Int          @map("balance_after")
  refType      String       @map("ref_type")
  refId        String       @map("ref_id")
  refNo        String       @map("ref_no")
  userId       String       @map("user_id")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([productId, createdAt(sort: Desc)])
  @@index([refNo])
  @@map("stock_movements")
}

model GoodsReceipt {
  id          String             @id @default(uuid())
  receiptNo   String             @unique @map("receipt_no")
  supplierId  String             @map("supplier_id")
  warehouseId String             @map("warehouse_id")
  status      GoodsReceiptStatus @default(DRAFT)
  receivedAt  DateTime?          @map("received_at")
  notes       String?
  createdById String             @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy User               @relation("CreatedGoodsReceipts", fields: [createdById], references: [id])
  items     GoodsReceiptItem[]

  @@index([status, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String    @id @default(uuid())
  goodsReceiptId String    @map("goods_receipt_id")
  productId      String    @map("product_id")
  locationId     String    @map("location_id")
  batchNo        String    @default("DEFAULT") @map("batch_no")
  expiryDate     DateTime? @map("expiry_date")
  quantity       Int
  unitPrice      Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  createdAt      DateTime  @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@map("goods_receipt_items")
}

model DeliveryOrder {
  id          String              @id @default(uuid())
  orderNo     String              @unique @map("order_no")
  customerId  String              @map("customer_id")
  warehouseId String              @map("warehouse_id")
  status      DeliveryOrderStatus @default(DRAFT)
  shippedAt   DateTime?           @map("shipped_at")
  notes       String?
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  customer  Customer            @relation(fields: [customerId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy User                @relation("CreatedDeliveryOrders", fields: [createdById], references: [id])
  items     DeliveryOrderItem[]

  @@index([status, createdAt])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              String   @id @default(uuid())
  deliveryOrderId String   @map("delivery_order_id")
  productId       String   @map("product_id")
  locationId      String   @map("location_id")
  batchId         String?  @map("batch_id")
  quantity        Int
  createdAt       DateTime @default(now()) @map("created_at")

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  location      Location      @relation(fields: [locationId], references: [id])
  batch         Batch?        @relation(fields: [batchId], references: [id])

  @@map("delivery_order_items")
}

model StockOpname {
  id              String            @id @default(uuid())
  opnameNo        String            @unique @map("opname_no")
  warehouseId     String            @map("warehouse_id")
  status          StockOpnameStatus @default(DRAFT)
  notes           String?
  rejectionReason String?           @map("rejection_reason")
  createdById     String            @map("created_by_id")
  approvedById    String?           @map("approved_by_id")
  submittedAt     DateTime?         @map("submitted_at")
  approvedAt      DateTime?         @map("approved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  warehouse  Warehouse         @relation(fields: [warehouseId], references: [id])
  createdBy  User              @relation("CreatedStockOpnames", fields: [createdById], references: [id])
  approvedBy User?             @relation("ApprovedStockOpnames", fields: [approvedById], references: [id])
  items      StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String   @id @default(uuid())
  stockOpnameId String   @map("stock_opname_id")
  productId     String   @map("product_id")
  locationId    String   @map("location_id")
  batchId       String   @map("batch_id")
  systemQty     Int      @map("system_qty")
  physicalQty   Int?     @map("physical_qty")
  difference    Int?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  location    Location    @relation(fields: [locationId], references: [id])
  batch       Batch       @relation(fields: [batchId], references: [id])

  @@map("stock_opname_items")
}

model DocumentCounter {
  id           String   @id @default(uuid())
  name         String   @unique
  currentValue Int      @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("document_counters")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userName    String?  @map("user_name")
  userRole    String?  @map("user_role")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  description String
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
